<Window x:Class="WPO.App.CleanupExecutionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="清理进度" Height="460" Width="680" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="StatusTextBlock" Text="正在清理，请稍候..." FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />

        <ProgressBar x:Name="ProgressBarControl" Grid.Row="1" IsIndeterminate="True" Height="18" Margin="0,12,0,0" />

        <DataGrid Grid.Row="2" x:Name="ResultsDataGrid" IsReadOnly="True" AutoGenerateColumns="False"
                  CanUserAddRows="False" HeadersVisibility="Column" Margin="0,12,0,0" Visibility="Collapsed">
            <DataGrid.Columns>
                <DataGridTextColumn Header="路径" Binding="{Binding FullPath}" Width="*" />
                <DataGridTextColumn Header="大小" Binding="{Binding DisplaySize}" Width="110" />
                <DataGridTextColumn Header="结果" Binding="{Binding StatusDisplay}" Width="90" />
                <DataGridTextColumn Header="说明" Binding="{Binding ErrorMessage}" Width="220" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="取消" Width="90" Height="32" Click="CancelButton_Click" />
            <Button x:Name="CloseButton" Content="关闭" Width="90" Height="32" Margin="12,0,0,0" IsEnabled="False" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
