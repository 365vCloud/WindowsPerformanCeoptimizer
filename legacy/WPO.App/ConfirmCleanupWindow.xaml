<Window x:Class="WPO.App.ConfirmCleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认清理" Height="360" Width="480" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="确认清理操作" FontSize="18" FontWeight="SemiBold" />

        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <TextBlock x:Name="SummaryTextBlock" TextWrapping="Wrap" />
            <TextBlock Text="处理方式：移动到回收站（可从回收站还原，不会永久删除文件）"
                       Margin="0,10,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />
            <TextBlock x:Name="RiskTextBlock" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="DarkOrange" />
        </StackPanel>

        <TextBlock Grid.Row="2" VerticalAlignment="Bottom" Foreground="DimGray" TextWrapping="Wrap"
                    Text="点击“确认清理”后还需要再次二次确认才会真正执行；取消、关闭窗口、按 Esc 或 Enter 都不会执行任何清理操作。" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="取消" Width="90" Height="32" IsCancel="True" Click="CancelButton_Click" />
            <Button x:Name="ConfirmButton" Content="确认清理" Width="110" Height="32" Margin="12,0,0,0" Click="ConfirmButton_Click" />
        </StackPanel>
    </Grid>
</Window>
