<Window x:Class="WPO.App.AuditLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="本地审计日志" Height="500" Width="860" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Text="日志仅包含脱敏的最小审计标识；不会包含文件内容、密码或令牌。" TextWrapping="Wrap" />
        <DataGrid x:Name="EntriesDataGrid" Grid.Row="1" Margin="0,12,0,0" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="刷新" Width="80" Click="RefreshButton_Click" />
            <Button Content="清除日志" Width="90" Margin="8,0,0,0" Click="ClearButton_Click" />
            <Button Content="关闭" Width="80" Margin="8,0,0,0" IsDefault="True" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
