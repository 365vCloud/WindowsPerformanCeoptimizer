<Window x:Class="WPO.App.CleanupResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="清理结果报告" Height="570" Width="900" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="StatusTextBlock" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="SummaryTextBlock" Grid.Row="1" Margin="0,10,0,0" TextWrapping="Wrap" />
        <DataGrid x:Name="ResultsDataGrid" Grid.Row="2" Margin="0,12,0,0" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="项目" Binding="{Binding FullPath}" Width="*" />
                <DataGridTextColumn Header="已选" Binding="{Binding WasSelected}" Width="60" />
                <DataGridTextColumn Header="状态" Binding="{Binding StatusDisplay}" Width="110" />
                <DataGridTextColumn Header="字节" Binding="{Binding DisplaySize}" Width="100" />
                <DataGridTextColumn Header="原因/说明" Binding="{Binding Detail}" Width="250" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="导出 CSV" Width="90" Click="ExportCsvButton_Click" />
            <Button Content="导出 JSON" Width="90" Margin="8,0,0,0" Click="ExportJsonButton_Click" />
            <Button Content="复制摘要" Width="90" Margin="8,0,0,0" Click="CopySummaryButton_Click" />
            <Button Content="查看本地审计日志" Width="130" Margin="8,0,0,0" Click="ViewAuditLogButton_Click" />
            <Button Content="关闭" Width="80" Margin="8,0,0,0" IsDefault="True" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
