<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <!--
      ICE43/ICE57 flag that the Start Menu shortcut's component uses the exe
      (a per-machine file) as its KeyPath instead of an HKCU registry value.
      That guidance targets per-user installs; this package is perMachine-
      only (Scope="perMachine"), so a file KeyPath is valid and suppressing
      these two ICEs is the standard approach - no Registry table rows are
      added by doing so.
    -->
    <!--
      ICE61 warns when AllowSameVersionUpgrades="yes" intentionally permits
      reinstalling a rebuilt MSI that keeps the same ProductVersion. That is
      a deliberate choice here so support can replace a stale exe with a
      freshly rebuilt same-version package.
    -->
    <SuppressIces>ICE43;ICE57;ICE61</SuppressIces>
    <RepoRoot>$(MSBuildProjectDirectory)\..\..\</RepoRoot>
    <TauriReleaseDir>$(RepoRoot)src-tauri\target\release\</TauriReleaseDir>
    <TauriExePath>$(TauriReleaseDir)wpo-app.exe</TauriExePath>
    <DefineConstants>$(DefineConstants);TauriExePath=$(TauriExePath)</DefineConstants>
  </PropertyGroup>

  <!--
    v2 packages the Tauri (Rust) build output instead of publishing the
    legacy WPF app. This target only *verifies* the exe already exists; it
    intentionally does not invoke cargo/npm itself, because doing so from
    inside an MSBuild target makes failures hard to diagnose and couples the
    installer build to toolchains (Rust/Node) that may not be present on
    every machine that just wants to rebuild the MSI from an existing
    Tauri release build. Run `npm run build` (which runs `tauri build`) in
    the repository root before building this project; see README.md.
  -->
  <Target Name="EnsureTauriBuildExists" BeforeTargets="_CreateProjectDefineConstants">
    <Error Condition="!Exists('$(TauriExePath)')"
           Text="Tauri release executable not found at '$(TauriExePath)'. Run 'npm install' then 'npm run build' (or 'npm run tauri build') from the repository root before building the MSI." />
  </Target>

</Project>
