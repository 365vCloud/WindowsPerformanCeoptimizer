<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <PublishOutputDirectory>$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)publish\</PublishOutputDirectory>
    <DefineConstants>$(DefineConstants);PublishOutputDirectory=$(PublishOutputDirectory)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WPO.App\WPO.App.csproj" />
  </ItemGroup>

  <Target Name="PublishApplication" BeforeTargets="_CreateProjectDefineConstants">
    <MSBuild Projects="..\..\src\WPO.App\WPO.App.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);PublishDir=$(PublishOutputDirectory);SelfContained=false;UseAppHost=true" />
  </Target>

</Project>
