<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Windows Performance Optimizer"
           Manufacturer="365vCloud"
           Version="0.1.0.0"
           UpgradeCode="6f2b6f1e-6f6b-4a1a-9c1b-8b1a2f2e9d10"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="WindowsPerformanceOptimizer" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder" />

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable">
        <File Id="WpoAppExe"
              Source="$(var.PublishOutputDirectory)WPO.App.exe"
              KeyPath="yes">
          <!--
            Non-advertised shortcut targeting the already-installed exe: this
            does not require any Registry table entries (those are only
            needed for advertised shortcuts), so it stays compatible with the
            "no Registry/no CustomAction" MSI validation. Without a Start
            Menu entry, users had no discoverable way to launch the app
            after installing, which was reported as "install succeeds but
            nothing seems to run".
          -->
          <Shortcut Id="StartMenuShortcut"
                    Directory="ProgramMenuFolder"
                    Name="Windows Performance Optimizer"
                    WorkingDirectory="INSTALLFOLDER"
                    Advertise="no" />
        </File>
      </Component>
      <Files Include="$(var.PublishOutputDirectory)**">
        <Exclude Files="$(var.PublishOutputDirectory)WPO.App.exe" />
      </Files>
    </ComponentGroup>

    <Feature Id="MainFeature" Title="Windows Performance Optimizer" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>
  </Package>
</Wix>
