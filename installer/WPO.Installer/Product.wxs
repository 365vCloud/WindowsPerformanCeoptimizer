<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Windows Performance Optimizer"
           Manufacturer="365vCloud"
           Version="0.1.0.0"
           UpgradeCode="6f2b6f1e-6f6b-4a1a-9c1b-8b1a2f2e9d10"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!--
      Skeleton installer definition. This is intentionally minimal: it defines
      the install directory and a single component that packages the WPF
      app's main executable. It does not run any elevated, system-modifying,
      or destructive custom actions - installation only copies files.
    -->
    <StandardDirectory Id="ProgramFilesFolder">
      <Directory Id="INSTALLFOLDER" Name="WindowsPerformanceOptimizer" />
    </StandardDirectory>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable">
        <File Id="WpoAppExe"
              Source="$(var.WPO.App.TargetDir)WPO.App.exe"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="MainFeature" Title="Windows Performance Optimizer" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>
  </Package>
</Wix>

